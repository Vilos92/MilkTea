{
  "name": "milktea",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prebuild": "bun export-presets",
    "build": "bun run typecheck && vp build",
    "build-storybook": "storybook build",
    "build:desktop": "tauri build",
    "check": "vp check",
    "predev": "bun export-presets",
    "dev": "vp dev",
    "dev:desktop": "tauri dev",
    "dev:pwa": "PWA_DEV=1 bun run dev",
    "export-presets": "bun run scripts/export-butterchurn-presets.ts",
    "fallow": "fallow --summary",
    "fallow:audit": "fallow audit",
    "fmt:check": "vp fmt --check",
    "fmt:fix": "vp fmt",
    "fmt:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "fmt:rust:fix": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "generate-pwa-assets": "pwa-assets-generator",
    "lint": "vp lint",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "lint:fix": "vp lint --fix",
    "prepare": "vp config",
    "preversion": "bun run release:check",
    "preview": "vp preview",
    "release": "bun pm version --message ':bookmark: Release v%s'",
    "release:check": "bun run scripts/validate-release.ts && vp check && vp test && bun run fallow:audit && bun run fmt:rust:check && bun run lint:rust",
    "release:sync": "bun run scripts/sync-release-version.ts && cargo check --manifest-path src-tauri/Cargo.toml && git add src-tauri/Cargo.toml src-tauri/Cargo.lock",
    "release:verify-tag": "bun run scripts/validate-release-tag.ts",
    "storybook": "storybook dev -p 6006",
    "test": "vp test",
    "typecheck": "tsc -b",
    "version": "bun run release:sync"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@vanilla-extract/css": "^1.21.2",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7",
    "mediabunny": "^1.38.1",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@preact/preset-vite": "^2.10.2",
    "@storybook/addon-a11y": "^10.2.16",
    "@storybook/addon-docs": "^10.2.16",
    "@storybook/addon-vitest": "^10.2.16",
    "@storybook/preact-vite": "^10.2.16",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.10.1",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "bun-types": "^1.3.9",
    "eslint-plugin-storybook": "^10.2.16",
    "fallow": "^2.75.0",
    "ora": "^9.3.0",
    "playwright": "^1.58.2",
    "storybook": "^10.2.16",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plus": "latest",
    "vitest": "4.1.10"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "4.1.10"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "fallow"
  ]
}
